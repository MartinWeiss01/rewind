# Copy to .env.local and fill in. Never commit real values.
# Every variable is validated at startup by the env schema.

# --- App ---
# Spotify requires a loopback IP (not "localhost") for local redirect URIs.
APP_URL=http://127.0.0.1:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# --- Spotify (Developer Dashboard app) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# --- Auth & crypto ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# 32-byte key, base64. Encrypts Spotify refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- AI (Vercel AI SDK; provider and model are swappable) ---
# One of: google | anthropic. Google must always work and is the default.
AI_PROVIDER=google
# Model ID for the provider above. Empty uses the default:
#   google    -> gemini-3.6-flash (stable, cheaper than 3.5 Flash, enough music knowledge;
#                gemini-3.5-flash-lite is cheaper still if suggestion quality holds up)
#   anthropic -> claude-opus-5-5
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# --- Demo mode ---
# Real LLM calls in demo mode (rate limited). Canned responses when false.
DEMO_LIVE_AI=false

# --- Scheduled sync ---
# Shared secret for the cron endpoint.
CRON_SECRET=

# Feature flags in Spotify mode: all, none (default) or comma-separated Spotify user IDs.
# Demo mode enables every flag.
FEATURE_STATS=
FEATURE_AI=
FEATURE_PLAYLIST_WRITE=
