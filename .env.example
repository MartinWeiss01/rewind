# Copy to .env.local and fill in. Never commit real values.
# Every variable is validated at startup by the env schema.

# --- App ---
# true for a public demo-only deployment: no other variable is needed, and any key that
# is set is ignored. Visitors' demo changes live in their own cookies.
DEMO_ONLY=false
# Spotify requires a loopback IP (not "localhost") for local redirect URIs.
APP_URL=http://127.0.0.1:3000

# --- Supabase ---
# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Secret key (server only)
SUPABASE_SECRET_KEY=
# Only for the Supabase CLI scripts (db:push, db:types): Connect → Session pooler URI
DATABASE_URL=

# --- Spotify (Developer Dashboard app) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# --- Crypto ---
# 32-byte key, base64 (openssl rand -base64 32). Encrypts Spotify refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- AI (Vercel AI SDK, Gemini) ---
# Gemini API key from Google AI Studio. Models are set per tier in src/server/ai.ts.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Demo mode ---
# Real LLM calls in demo mode (rate limited). Canned responses when false.
DEMO_LIVE_AI=false

# --- Scheduled sync ---
# Shared secret for GET /api/cron/sync (Authorization: Bearer <secret>). No schedule is
# configured: the public deployment is demo-only and syncs also run when the app is opened.
CRON_SECRET=

